+	draft := entry.workspace.Draft()
+	summary := summarizeReview(draft)
+	b.WriteString(shared.Theme.Chat.Hint.Render(summary.String()))
+	b.WriteByte('\n')
+	if summary.Blocking > 0 {
+		b.WriteString(shared.Theme.Badge.Warning.Render(" blocking feedback "))
+		b.WriteString(" Resolve or submit with revise.")
+		return
+	}
+	if summary.Reviewed == 0 {
+		b.WriteString(shared.Theme.Chat.Hint.Render("Open the workspace and inspect each document."))
+		return
+	}
+	b.WriteString(shared.Theme.Chat.Hint.Render("Choose a verdict when the review is complete."))
 }
