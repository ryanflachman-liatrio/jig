diff --git a/internal/tui/monitor/review_summary.go b/internal/tui/monitor/review_summary.go
new file mode 100644
index 0000000..70e95c1
--- /dev/null
+++ b/internal/tui/monitor/review_summary.go
@@ -0,0 +1,32 @@
+package monitor
+
+import (
+	"fmt"
+	"sort"
+
+	domain "jig/internal/review"
+)
+
+type reviewSummary struct {
+	Documents int
+	Reviewed  int
+	Comments  int
+	Blocking  int
+}
+
+func summarizeReview(draft domain.Draft) reviewSummary {
+	summary := reviewSummary{Reviewed: len(draft.Reviewed), Comments: len(draft.Comments)}
+	seen := make(map[string]struct{})
+	for _, comment := range draft.Comments {
+		seen[comment.Anchor.DocumentID] = struct{}{}
+		if comment.Kind == domain.KindBlocking {
+			summary.Blocking++
+		}
+	}
+	summary.Documents = len(seen)
+	return summary
+}
+
+func (s reviewSummary) String() string {
+	return fmt.Sprintf("%d reviewed · %d comments · %d blocking", s.Reviewed, s.Comments, s.Blocking)
+}
